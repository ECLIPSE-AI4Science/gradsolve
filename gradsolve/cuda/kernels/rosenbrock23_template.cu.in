// gradsolve cuda_rosenbrock23 — generic adaptive Rosenbrock23 (ode23s) stiff forward-only
// kernel (codegen template). The stiff analogue of tsit5_template.cu.in.
//
// gradsolve/cuda/_codegen.py fills (str.replace, not format): the scalar type, the FFI element
// dtype, the Rosenbrock coefficient #defines DCOEF/E32 (from gradsolve.solvers.rosenbrock23_step,
// shared with the JAX solvers), the per-field RHS body and its analytic Jacobian body
// (gradsolve/cuda/_stiff_fields.py), the DIM dimension literal and the NPARAM param-count
// literal. NB: the fill tokens deliberately appear nowhere in this comment (multi-line content
// must not be spliced into a // block).
//
// Host/device dual: under __CUDACC__ it builds the CUDA kernel + a transposed-SoA launcher;
// otherwise a host main (reads a batch on stdin, integrates, prints final states + step
// counts) so the entire kernel logic is testable on the CPU (only PTX register
// residency needs the GPU). The kernel integrates one trajectory per thread with the
// Rosenbrock23 pair of Shampine & Reichelt (1997).
//
// Two design choices:
//   1. Field/jac take a param vector. field(t, s, p, dy) and jac(t, s, p, J) — the stiff
//      problems carry per-trajectory params (Robertson = [k1,k2,k3]; HIRES = autonomous, p
//      ignored). The Tsit5 lane's `real rho` scalar ABI does not generalize, so the wire
//      format here carries params[NPARAM, n] SoA and a param dimension P.
//   2. Factor W once per step, then reuse across the three stage solves. W = I - d*h*J is
//      LU-factored in place (partial pivot) once, and k1/k2/k3 are back-substitutions of the
//      same factors — standard efficient ode23s, not the per-RHS re-elimination the Warp
//      kernel does. Mathematically identical (<=1e-14 rounding), so this kernel is not
//      bit-parity with warp_rosenbrock; it validates to the 1e-8 y_final floor against the
//      numpy reference / scipy Radau / expm, not against the Warp step sequence.
#include <math.h>
#ifdef __CUDACC__
  #define HD __host__ __device__
  #define REST __restrict__
#else
  #include <cstdio>
  #include <cstdlib>
  #define HD
  #define REST
#endif

typedef @SCALAR@ real;

// --- Rosenbrock23 coefficients (single source: gradsolve.solvers.rosenbrock23_step) ---
@TABLEAU@
// controller — order-2 propagated solution => error exponent -1/3 (not Tsit5's -1/5);
// constants match gradsolve/warp/_warp_rosenbrock.py.
#define SAFETY    ((real)0.9)
#define ERR_FLOOR ((real)1e-10)
#define FAC_MIN   ((real)0.2)
#define FAC_MAX   ((real)5.0)
#define ORDER_EXP ((real)(-1.0/3.0))
#define DIM @D@
#define NPARAM @P@

// --- per-field RHS f(t, s, p) -> dy AND analytic Jacobian jac(t, s, p) -> J (row-major DxD).
//     Design choice 1: both take the per-trajectory param vector `p`. ---
@FIELD@
@JAC@

// In-place partial-pivot LU factorization of a DIM x DIM row-major matrix A (choice 2:
// factored ONCE per step, then reused by the three stage solves). Unit-lower L stored below
// the diagonal, U on/above; `piv[k]` is the row swapped to position k.
HD inline void lu_factor(real* REST A, int* REST piv) {
  for (int k = 0; k < DIM; ++k) {
    int prow = k; real pmax = fabs(A[k * DIM + k]);
    for (int i = k + 1; i < DIM; ++i) {
      real a = fabs(A[i * DIM + k]); if (a > pmax) { pmax = a; prow = i; }
    }
    piv[k] = prow;
    if (prow != k)
      for (int j = 0; j < DIM; ++j) { real t = A[k * DIM + j]; A[k * DIM + j] = A[prow * DIM + j]; A[prow * DIM + j] = t; }
    real akk = A[k * DIM + k];
    for (int i = k + 1; i < DIM; ++i) {
      real fac = A[i * DIM + k] / akk; A[i * DIM + k] = fac;
      for (int j = k + 1; j < DIM; ++j) A[i * DIM + j] -= fac * A[k * DIM + j];
    }
  }
}

// Solve A x = b using the in-place LU factors from lu_factor (b and x may NOT alias).
HD inline void lu_solve(const real* REST A, const int* REST piv, const real* REST b, real* REST x) {
  for (int i = 0; i < DIM; ++i) x[i] = b[i];
  for (int k = 0; k < DIM; ++k) { int pr = piv[k]; if (pr != k) { real t = x[k]; x[k] = x[pr]; x[pr] = t; } }
  for (int i = 0; i < DIM; ++i) { real s = x[i]; for (int j = 0; j < i; ++j) s -= A[i * DIM + j] * x[j]; x[i] = s; }        // Ly = Pb
  for (int i = DIM - 1; i >= 0; --i) { real s = x[i]; for (int j = i + 1; j < DIM; ++j) s -= A[i * DIM + j] * x[j]; x[i] = s / A[i * DIM + i]; } // Ux = y
}

// One trajectory, register/stack-resident state (DIM/NPARAM compile-time literals). Exact-f64
// controller. Autonomous ode23s: J = jac(y); W = I - d*h*J factored once; F0/F1/F2 the three
// RHS evals; k1/k2/k3 the three W-solves; WRMS embedded error; I-controller (exp -1/3).
HD inline void rosenbrock23_fwd_one(const real* REST y0, const real* REST p, real t1,
                                    real rtol, real atol, int max_steps,
                                    real* REST yf, int* REST nsteps) {
  real y[DIM], ynew[DIM], F0[DIM], F1[DIM], F2[DIM], k1[DIM], k2[DIM], k3[DIM], s[DIM];
  real W[DIM * DIM]; int piv[DIM];
  #pragma unroll
  for (int i = 0; i < DIM; ++i) y[i] = y0[i];
  real t = (real)0, dt = t1 / (real)100;                 // t0 = 0, dt0 = t1/100
  int steps = 0;
  for (int it = 0; it < max_steps; ++it) {
    if (t >= t1) break;
    real h = dt; if (t + h > t1) h = t1 - t;
    jac(t, y, p, W);                                      // W <- J
    real dh = DCOEF * h;
    #pragma unroll
    for (int a = 0; a < DIM * DIM; ++a) W[a] = -dh * W[a];
    #pragma unroll
    for (int i = 0; i < DIM; ++i) W[i * DIM + i] += (real)1;   // W = I - d*h*J
    lu_factor(W, piv);
    field(t, y, p, F0);
    lu_solve(W, piv, F0, k1);                             // k1 = W^-1 F0
    #pragma unroll
    for (int i = 0; i < DIM; ++i) s[i] = y[i] + (real)0.5 * h * k1[i];
    field(t, s, p, F1);
    #pragma unroll
    for (int i = 0; i < DIM; ++i) s[i] = F1[i] - k1[i];
    lu_solve(W, piv, s, k2);
    #pragma unroll
    for (int i = 0; i < DIM; ++i) k2[i] += k1[i];         // k2 = W^-1(F1 - k1) + k1
    #pragma unroll
    for (int i = 0; i < DIM; ++i) ynew[i] = y[i] + h * k2[i];
    field(t, ynew, p, F2);
    #pragma unroll
    for (int i = 0; i < DIM; ++i) s[i] = F2[i] - E32 * (k2[i] - F1[i]) - (real)2 * (k1[i] - F0[i]);
    lu_solve(W, piv, s, k3);                              // k3 = W^-1(F2 - e32*(k2-F1) - 2*(k1-F0))
    real err2 = (real)0;
    #pragma unroll
    for (int i = 0; i < DIM; ++i) {
      real ev = (h / (real)6) * (k1[i] - (real)2 * k2[i] + k3[i]);    // (h/6)*(k1 - 2k2 + k3)
      real sc = atol + rtol * fmax(fabs(y[i]), fabs(ynew[i]));
      real e0 = ev / sc; err2 += e0 * e0;
    }
    real err = sqrt(err2 / (real)DIM);                   // WRMS over DIM
    if (err <= (real)1) {
      t += h;
      #pragma unroll
      for (int i = 0; i < DIM; ++i) y[i] = ynew[i];
      ++steps;
    }
    real ef = fmax(err, ERR_FLOOR);
    real fac = SAFETY * pow(ef, ORDER_EXP);
    fac = fmin(fmax(fac, FAC_MIN), FAC_MAX);
    dt = h * fac;                                         // controller runs on accept AND reject
  }
  #pragma unroll
  for (int i = 0; i < DIM; ++i) yf[i] = y[i];
  if (nsteps) *nsteps = steps;
}

#ifdef __CUDACC__
// Device kernel: one thread per trajectory, transposed-SoA I/O. params carried as p[NPARAM,n]
// SoA (choice 1). `p` may be an empty view when NPARAM == 0 (autonomous fields ignore it).
extern "C" __global__ void rosenbrock23_kernel(const real* __restrict__ y0, const real* __restrict__ p,
                                               real* __restrict__ yf, int* __restrict__ ns,
                                               int n, real t1, real rtol, real atol, int max_steps) {
  int tid = blockIdx.x * blockDim.x + threadIdx.x;
  if (tid >= n) return;
  real yloc[DIM], ploc[NPARAM + 1], yfl[DIM]; int st;    // +1 keeps ploc a valid array when NPARAM == 0
  #pragma unroll
  for (int i = 0; i < DIM; ++i) yloc[i] = y0[i * n + tid];
  for (int c = 0; c < NPARAM; ++c) ploc[c] = p[c * n + tid];
  rosenbrock23_fwd_one(yloc, ploc, t1, rtol, atol, max_steps, yfl, &st);
  #pragma unroll
  for (int i = 0; i < DIM; ++i) yf[i * n + tid] = yfl[i];
  if (ns) ns[tid] = st;
}
#endif

// ---- XLA typed-FFI handler `Rosenbrock23Fwd` (jax.ffi). Same handler symbol on CPU and CUDA
// so the Python bridge registers one name per platform. I/O: y0[DIM,n] + p[NPARAM,n]
// (transposed-SoA) -> yf[DIM,n] + nsteps[n] (s32); attrs t1/rtol/atol (f64) + max_steps (s64).
// Forward-only by construction (no autodiff rule). ----
#ifdef GRADSOLVE_FFI
#include "xla/ffi/api/ffi.h"
namespace ffi = xla::ffi;

#ifdef __CUDACC__
ffi::Error Rosenbrock23FwdImpl(cudaStream_t stream,
                               ffi::Buffer<@FFI_DTYPE@> y0, ffi::Buffer<@FFI_DTYPE@> p,
                               ffi::ResultBuffer<@FFI_DTYPE@> yf, ffi::ResultBuffer<ffi::S32> ns,
                               double t1, double rtol, double atol, int64_t max_steps) {
  auto dims = y0.dimensions();
  long long n = (long long)dims.back();
  int block = 128, grid = (int)((n + block - 1) / block);
  rosenbrock23_kernel<<<grid, block, 0, stream>>>(
      y0.typed_data(), p.typed_data(), yf->typed_data(), ns->typed_data(),
      (int)n, (real)t1, (real)rtol, (real)atol, (int)max_steps);
  cudaError_t e = cudaGetLastError();
  if (e != cudaSuccess) return ffi::Error::Internal(std::string("CUDA: ") + cudaGetErrorString(e));
  return ffi::Error::Success();
}
XLA_FFI_DEFINE_HANDLER_SYMBOL(
    Rosenbrock23Fwd, Rosenbrock23FwdImpl,
    ffi::Ffi::Bind().Ctx<ffi::PlatformStream<cudaStream_t>>()
        .Arg<ffi::Buffer<@FFI_DTYPE@>>().Arg<ffi::Buffer<@FFI_DTYPE@>>()
        .Ret<ffi::Buffer<@FFI_DTYPE@>>().Ret<ffi::Buffer<ffi::S32>>()
        .Attr<double>("t1").Attr<double>("rtol").Attr<double>("atol").Attr<int64_t>("max_steps"));
#else   // CPU FFI handler (host loop) — the CPU validation target
ffi::Error Rosenbrock23FwdImpl(ffi::Buffer<@FFI_DTYPE@> y0, ffi::Buffer<@FFI_DTYPE@> p,
                               ffi::ResultBuffer<@FFI_DTYPE@> yf, ffi::ResultBuffer<ffi::S32> ns,
                               double t1, double rtol, double atol, int64_t max_steps) {
  auto dims = y0.dimensions();
  long long n = (long long)dims.back();
  const real* y0p = y0.typed_data();
  const real* pp = p.typed_data();
  real* yfp = yf->typed_data();
  int* nsp = ns->typed_data();
  for (long long i = 0; i < n; ++i) {
    real yl[DIM], pl[NPARAM + 1], yfl[DIM]; int st;
    for (int d = 0; d < DIM; ++d) yl[d] = y0p[(long long)d * n + i];
    for (int c = 0; c < NPARAM; ++c) pl[c] = pp[(long long)c * n + i];
    rosenbrock23_fwd_one(yl, pl, (real)t1, (real)rtol, (real)atol, (int)max_steps, yfl, &st);
    for (int d = 0; d < DIM; ++d) yfp[(long long)d * n + i] = yfl[d];
    nsp[i] = st;
  }
  return ffi::Error::Success();
}
XLA_FFI_DEFINE_HANDLER_SYMBOL(
    Rosenbrock23Fwd, Rosenbrock23FwdImpl,
    ffi::Ffi::Bind()
        .Arg<ffi::Buffer<@FFI_DTYPE@>>().Arg<ffi::Buffer<@FFI_DTYPE@>>()
        .Ret<ffi::Buffer<@FFI_DTYPE@>>().Ret<ffi::Buffer<ffi::S32>>()
        .Attr<double>("t1").Attr<double>("rtol").Attr<double>("atol").Attr<int64_t>("max_steps"));
#endif  // __CUDACC__
#endif  // GRADSOLVE_FFI

#ifdef GRADSOLVE_HOST_MAIN
// Standalone host program (CPU check): stdin "D P n t1 rtol atol" then n*(D y0 + P p);
// stdout n lines "yf[0..D-1] steps". No FFI/CUDA deps -> compiles with bare clang.
int main() {
  int D, P, n; double t1, rtol, atol;
  if (scanf("%d %d %d %lf %lf %lf", &D, &P, &n, &t1, &rtol, &atol) != 6) return 1;
  if (D != DIM) { fprintf(stderr, "D mismatch %d != %d\n", D, DIM); return 2; }
  if (P != NPARAM) { fprintf(stderr, "P mismatch %d != %d\n", P, NPARAM); return 4; }
  for (int j = 0; j < n; ++j) {
    real y0[DIM], p[NPARAM + 1], yf[DIM]; int st;
    for (int i = 0; i < DIM; ++i) { double v; if (scanf("%lf", &v) != 1) return 3; y0[i] = (real)v; }
    for (int c = 0; c < NPARAM; ++c) { double v; if (scanf("%lf", &v) != 1) return 3; p[c] = (real)v; }
    rosenbrock23_fwd_one(y0, p, (real)t1, (real)rtol, (real)atol, 50000, yf, &st);
    for (int i = 0; i < DIM; ++i) printf("%.17e ", (double)yf[i]);
    printf("%d\n", st);
  }
  return 0;
}
#endif
